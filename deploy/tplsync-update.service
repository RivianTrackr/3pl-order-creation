[Unit]
Description=Update 3PL Order Sync from GitHub (started by the admin's Update button)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Root-owned copy installed by setup.sh; the admin can only ask for an update, never change what it runs.
ExecStart=/usr/local/sbin/tplsync-update
TimeoutStartSec=15min
