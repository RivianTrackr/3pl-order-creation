# Server bootstrap only. API keys, client credentials and shipping rules are
# managed in the admin UI and stored (encrypted) in the database.

DB_PATH=/opt/tplsync/tplsync.db

# Generate both with: python -m tplsync gen-keys
# Keep TPLSYNC_ENCRYPTION_KEY safe - without it saved secrets can't be decrypted.
TPLSYNC_ENCRYPTION_KEY=
ADMIN_SECRET_KEY=

# Where daily database backups are written (default: ./backups)
BACKUP_DIR=/opt/tplsync/backups

# Admin UI listens here; put Nginx with HTTPS in front of it.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8120
# Set to false only for local development over plain http.
ADMIN_COOKIE_SECURE=true
